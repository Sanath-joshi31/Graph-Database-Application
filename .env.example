# CognoDB Graph Database Connection Credentials
# Obtain these credentials from your CognoDB Cloud Console
COGNODB_URI=bolt+s://your-cognoDB-instance.cognoDB.cloud:7687
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=your_secure_password_here

# Application Configuration
NEXT_PUBLIC_APP_TITLE=PathGraph
NEXT_PUBLIC_APP_URL=http://localhost:3000
